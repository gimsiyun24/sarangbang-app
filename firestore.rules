rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 승인 절차 없음 — Google 로그인한 사람 = 멤버
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // 문서에 기록된 작성자가 나인가
    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }
    function willBeAuthor() {
      return signedIn() && request.resource.data.authorUid == request.auth.uid;
    }
    // 이번 수정이 건드리는 필드가 허용 목록 안에만 있는가.
    // "읽음 표시만 바꾸게" 같은 걸 필드 단위로 막을 때 씁니다.
    function onlyFields(fields) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(fields);
    }

    match /groups/{gid} {
      allow read: if signedIn();
      allow write: if false;              // 청년부 정보는 콘솔에서만 수정

      // ── 프로필 (청년부 공통) ─────────────────────────
      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if isMe(uid);
        allow delete: if isMe(uid);

        // 생일 롤링페이퍼 — 누구나 남기고, 쓴 사람만 지움
        match /birthdayCards/{year}/messages/{mid} {
          allow read: if signedIn();
          allow create: if willBeAuthor();
          allow update, delete: if isAuthor();
        }
      }

      // ── 푸시 알림을 받을 기기 ───────────────────────
      // 문서 id 가 그 기기의 FCM 토큰. 본인 것만 적고 지웁니다.
      // 목록은 아무도 못 봅니다 — 알림을 보내는 쪽은 규칙을 건너뛰는 서버(netlify/functions/push.mts)입니다.
      // pushLog(보낸 표시)는 서버만 쓰는 자리라 여기 적지 않습니다.
      match /pushTokens/{token} {
        allow get: if signedIn() && resource.data.uid == request.auth.uid;
        allow list: if false;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn()
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // ── 사랑방 (희진 / 평강 / 전체) ───────────────────
      match /rooms/{roomId} {
        allow read: if signedIn();
        allow create, update: if signedIn();   // 방 문서는 앱이 필요할 때 만듭니다
        allow delete: if false;

        // 주차 / 기도제목 — 분반 사랑방에서만 씁니다
        match /weeks/{wid} {
          allow read: if signedIn();
          allow create, update: if signedIn();
          allow delete: if false;

          // 공개 문서 — 본인만 쓰기, 공개된 것만 남이 읽기
          match /prayers/{uid} {
            allow read: if isMe(uid)
                        || (signedIn() && resource.data.visibility == 'all');
            allow create, update: if isMe(uid);
            allow delete: if isMe(uid);

            // ⭐ "나만 보기" 항목 — 본인 외 아무도 읽을 수 없음
            match /private/{pid} {
              allow read, write: if isMe(uid);
            }
          }
        }

        // 🙏 기도했어요 — 기도제목 문서는 본인만 쓸 수 있어 반응은 별도 컬렉션
        match /prayerReactions/{rid} {
          allow read: if signedIn();
          allow create: if signedIn()
                        && request.resource.data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if signedIn()
                        && resource.data.uid == request.auth.uid;
        }

        // 신앙루틴 체크 — 본인 것만
        match /routineLogs/{logId} {
          allow read: if signedIn();
          allow create, update: if signedIn()
                                && request.resource.data.uid == request.auth.uid;
          allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        }

        // 💬 채팅 — 보낸 사람만 쓰고 지울 수 있음. 수정은 불가
        match /messages/{mid} {
          allow read: if signedIn();
          allow create: if signedIn()
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 2000;
          allow update: if false;
          allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        }

        // 모임 / 출석
        match /meetings/{mid} {
          allow read: if signedIn();
          allow create, update: if signedIn();
          allow delete: if isAuthor();

          match /attendance/{uid} {
            allow read: if signedIn();
            allow write: if isMe(uid);     // 출석은 본인만 체크
          }
        }

        // 앨범 / 사진
        match /albums/{aid} {
          allow read: if signedIn();
          allow create, update: if signedIn();
          allow delete: if isAuthor();

          match /photos/{pid} {
            allow read: if signedIn();
            allow create: if signedIn()
                          && request.resource.data.uploaderUid == request.auth.uid;
            // 올린 사람은 전부 고칠 수 있고, 남은 좋아요·숨김만 건드립니다.
            // (예전엔 로그인만 하면 사진 URL 까지 바꿀 수 있었습니다)
            allow update: if signedIn()
                          && (resource.data.uploaderUid == request.auth.uid
                              || onlyFields(['likes', 'hidden']));
            allow delete: if signedIn()
                          && resource.data.uploaderUid == request.auth.uid;
          }
        }

        // 공지
        match /notices/{nid} {
          allow read: if signedIn();
          allow create: if willBeAuthor();
          // 작성자는 전부, 남은 읽음 표시(readBy)만. 본문·고정은 못 건드립니다.
          allow update: if isAuthor() || (signedIn() && onlyFields(['readBy']));
          allow delete: if isAuthor();
        }

        // 투표
        match /polls/{pid} {
          allow read: if signedIn();
          allow create: if willBeAuthor();
          // 작성자는 전부, 남은 options(자기 표)만. 제목·마감은 못 건드립니다.
          allow update: if isAuthor() || (signedIn() && onlyFields(['options']));
          allow delete: if isAuthor();
        }

        // 정산
        match /settlements/{sid} {
          allow read: if signedIn();
          allow create: if willBeAuthor();
          // 작성자는 전부, 남은 입금완료(paid) 체크만. 금액·항목은 못 건드립니다.
          allow update: if isAuthor() || (signedIn() && onlyFields(['paid']));
          allow delete: if isAuthor();
        }

        // 말씀 노트
        match /sermonNotes/{nid} {
          allow read: if signedIn();
          allow create: if willBeAuthor();
          allow update, delete: if isAuthor();
        }
      }
    }
  }
}
